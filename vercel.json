{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/(lib|src|tools|QA-[^/]*)(/.*)?$",
      "status": 404
    },
    {
      "src": "^/(README[^/]*|RAPORT[^/]*|PAKIET[^/]*|ARCHITEKTURA[^/]*|GITHUB[^/]*|ASSET_MANIFEST\\.json|package(-lock)?\\.json|\\.env[^/]*|\\.gitignore|vercel\\.json)$",
      "status": 404
    }
  ],
  "functions": {
    "api/interview.js": {
      "maxDuration": 60
    }
  }
}
