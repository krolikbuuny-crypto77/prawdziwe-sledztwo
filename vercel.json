{
  "headers": [
    {
      "source": "/ps-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/(lib|src|tools|docs|story-bible|supabase|QA-[^/]*|qa[0-9]+(?:-baseline)?|TEST-[^/]*)(/.*)?$",
      "status": 404
    },
    {
      "src": "^/[^/]+\\.(?:md|json|txt|log|py)$",
      "status": 404
    },
    {
      "src": "^/(README[^/]*|RAPORT[^/]*|PAKIET[^/]*|ARCHITEKTURA[^/]*|GITHUB[^/]*|ASSET_MANIFEST\\.json|package(-lock)?\\.json|\\.env[^/]*|\\.gitignore|vercel\\.json)$",
      "status": 404
    }
  ],
  "functions": {
    "api/admin-rc57.js": {
      "maxDuration": 60
    },
    "api/interview.js": {
      "maxDuration": 300
    },
    "api/defense-objections.js": {
      "maxDuration": 175
    },
    "api/evidence-review.js": {
      "maxDuration": 90
    },
    "api/lab-narrative.js": {
      "maxDuration": 80
    }
  },
  "rewrites": [
    {
      "source": "/admin/testy",
      "destination": "/api/admin-rc57?view=page"
    },
    {
      "source": "/admin/testy/",
      "destination": "/api/admin-rc57?view=page"
    },
    {
      "source": "/api/status",
      "destination": "/api/admin-rc57?view=service-status"
    }
  ]
}
