# Ustaw jako sekrety projektu Vercel — nigdy w index.html ani na GitHubie.
ZAI_API_KEY=insert-your-zai-api-key-in-vercel-settings
# Wybierz najmocniejszy model dostępny dla własnego klucza Z.ai;
# sprawdź obsługę JSON, opóźnienia i koszty na Vercel Preview.
# Starsza, zachowawcza wartość referencyjna:
ZAI_MODEL=glm-4.6
# Opcjonalnie sprawdź nowszy model oferowany na Twoim koncie.

# Pakiet 6.16: pomocnicza analiza materiału dowodowego przez Cloudflare Workers AI
# Dodaj jako zmienne środowiskowe po stronie Vercel, nigdy rzeczywiste wartości do GitHuba.
CLOUDFLARE_ACCOUNT_ID=insert-cloudflare-account-id-in-vercel-settings
CLOUDFLARE_API_TOKEN=insert-cloudflare-workers-ai-token-in-vercel-settings

# Pakiet 6.17: Groq jako zapasowy model przesłuchań.
GROQ_API_KEY=your-groq-key-in-vercel
GROQ_MODEL=llama-3.3-70b-versatile

# Pakiet 6.17: serwerowy dziennik i walidacja postępu (wymaga migracji SQL).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-server-only
# Losowy, mocny sekret min. 32 znaki; nie przesyłaj go przeglądarce.
GAME_SESSION_SECRET=replace-with-a-long-random-session-signing-secret
